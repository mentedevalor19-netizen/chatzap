generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  AGENT
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  LOCATION
  CONTACT
  STICKER
  TEMPLATE
  SYSTEM
}

enum MessageStatus {
  QUEUED
  RECEIVED
  SENT
  DELIVERED
  READ
  FAILED
}

enum FunnelStepType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

enum FunnelRunStatus {
  RUNNING
  WAITING_FOR_REPLY
  COMPLETED
  CANCELLED
}

enum SaleStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum ExpenseCategory {
  ADS
  SUPPLIER
  TOOLS
  OTHER
}

enum MetaConversionStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users        User[]
  contacts     Contact[]
  conversations Conversation[]
  messages     Message[]
  tags         Tag[]
  notes        Note[]
  funnels      Funnel[]
  funnelSteps  FunnelStep[]
  funnelRuns   ConversationFunnelRun[]
  quickReplies QuickReply[]
  sales        Sale[]
  expenses     Expense[]
  metaSettings MetaIntegrationSetting?
  adAttributions AdAttribution[]
  metaConversionEvents MetaConversionEvent[]

  @@map("organizations")
}

model User {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  role           UserRole @default(AGENT)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization          Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messages              Message[]
  notes                 Note[]
  assignedConversations Conversation[] @relation("AssignedConversations")
  sales                 Sale[]         @relation("SellerSales")
  expensesCreated       Expense[]      @relation("ExpenseCreator")

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("users")
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  waId           String   @map("wa_id")
  phone          String
  name           String
  avatarUrl      String?  @map("avatar_url")
  lastSeenAt     DateTime? @map("last_seen_at")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversations Conversation[]
  messages      Message[]
  tags          ContactTag[]
  notes         Note[]
  sales         Sale[]
  adAttributions AdAttribution[]
  metaConversionEvents MetaConversionEvent[]

  @@unique([organizationId, waId])
  @@index([organizationId, phone])
  @@index([organizationId, name])
  @@map("contacts")
}

model Conversation {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  contactId      String             @map("contact_id")
  assignedToId   String?            @map("assigned_to_id")
  status         ConversationStatus @default(OPEN)
  unreadCount    Int                @default(0) @map("unread_count")
  lastMessageAt  DateTime?          @map("last_message_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AssignedConversations", fields: [assignedToId], references: [id], onDelete: SetNull)
  messages     Message[]
  funnelRuns   ConversationFunnelRun[]
  sales        Sale[]
  adAttributions AdAttribution[]
  metaConversionEvents MetaConversionEvent[]

  @@index([organizationId, status, lastMessageAt])
  @@index([organizationId, contactId])
  @@map("conversations")
}

model Message {
  id                String           @id @default(cuid())
  organizationId    String           @map("organization_id")
  conversationId    String           @map("conversation_id")
  contactId         String           @map("contact_id")
  senderUserId      String?          @map("sender_user_id")
  waMessageId       String?          @unique @map("wa_message_id")
  direction         MessageDirection
  type              MessageType
  status            MessageStatus    @default(QUEUED)
  body              String?
  mediaId           String?          @map("media_id")
  mediaUrl          String?          @map("media_url")
  mimeType          String?          @map("mime_type")
  fileName          String?          @map("file_name")
  caption           String?
  locationLatitude  Decimal?         @map("location_latitude") @db.Decimal(10, 7)
  locationLongitude Decimal?         @map("location_longitude") @db.Decimal(10, 7)
  locationName      String?          @map("location_name")
  locationAddress   String?          @map("location_address")
  contactPayload    Json?            @map("contact_payload")
  rawPayload        Json?            @map("raw_payload")
  sentAt            DateTime?        @map("sent_at")
  deliveredAt       DateTime?        @map("delivered_at")
  readAt            DateTime?        @map("read_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  senderUser   User?        @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, conversationId, createdAt])
  @@index([organizationId, contactId])
  @@index([organizationId, direction, status])
  @@map("messages")
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  color          String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts     ContactTag[]

  @@unique([organizationId, name])
  @@map("tags")
}

model ContactTag {
  contactId      String   @map("contact_id")
  tagId          String   @map("tag_id")
  organizationId String   @map("organization_id")
  createdAt      DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@index([organizationId])
  @@map("contact_tags")
}

model Note {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  contactId      String   @map("contact_id")
  userId         String   @map("user_id")
  body           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, contactId, createdAt])
  @@map("notes")
}

model Funnel {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  isActive       Boolean  @default(false) @map("is_active")
  handoffMessage String?  @map("handoff_message")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        FunnelStep[]
  runs         ConversationFunnelRun[]

  @@index([organizationId, isActive])
  @@map("funnels")
}

model FunnelStep {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  funnelId       String         @map("funnel_id")
  position       Int
  type           FunnelStepType @default(TEXT)
  body           String?
  mediaId        String?        @map("media_id")
  mediaUrl       String?        @map("media_url")
  mimeType       String?        @map("mime_type")
  fileName       String?        @map("file_name")
  caption        String?
  delaySeconds   Int            @default(0) @map("delay_seconds")
  audioAsVoice   Boolean        @default(false) @map("audio_as_voice")
  waitForReply   Boolean        @default(false) @map("wait_for_reply")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  funnel       Funnel       @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, position])
  @@index([organizationId, funnelId, position])
  @@map("funnel_steps")
}

model ConversationFunnelRun {
  id               String          @id @default(cuid())
  organizationId   String          @map("organization_id")
  conversationId   String          @map("conversation_id")
  funnelId         String          @map("funnel_id")
  status           FunnelRunStatus @default(RUNNING)
  nextStepPosition Int             @default(1) @map("next_step_position")
  awaitingReply    Boolean         @default(false) @map("awaiting_reply")
  startedAt        DateTime        @default(now()) @map("started_at")
  completedAt      DateTime?       @map("completed_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  funnel       Funnel       @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, conversationId, status])
  @@map("conversation_funnel_runs")
}

model QuickReply {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  shortcut       String
  body           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, shortcut])
  @@index([organizationId, shortcut])
  @@map("quick_replies")
}

model Sale {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  sellerId       String?    @map("seller_id")
  contactId      String?    @map("contact_id")
  conversationId String?    @map("conversation_id")
  title          String
  amount         Decimal    @db.Decimal(12, 2)
  status         SaleStatus @default(PAID)
  note           String?
  soldAt         DateTime   @default(now()) @map("sold_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  seller       User?         @relation("SellerSales", fields: [sellerId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  metaConversionEvents MetaConversionEvent[]

  @@index([organizationId, soldAt])
  @@index([organizationId, sellerId, soldAt])
  @@index([organizationId, status, soldAt])
  @@map("sales")
}

model Expense {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  createdById    String?         @map("created_by_id")
  category       ExpenseCategory @default(OTHER)
  description    String
  amount         Decimal         @db.Decimal(12, 2)
  spentAt        DateTime        @default(now()) @map("spent_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?        @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, spentAt])
  @@index([organizationId, category, spentAt])
  @@map("expenses")
}

model MetaIntegrationSetting {
  id                        String   @id @default(cuid())
  organizationId            String   @unique @map("organization_id")
  isEnabled                 Boolean  @default(false) @map("is_enabled")
  datasetId                 String?  @map("dataset_id")
  whatsappBusinessAccountId String?  @map("whatsapp_business_account_id")
  graphApiVersion           String?  @map("graph_api_version")
  accessTokenEncrypted      String?  @map("access_token_encrypted")
  testEventCode             String?  @map("test_event_code")
  currency                  String   @default("BRL")
  sendLeadEvents            Boolean  @default(false) @map("send_lead_events")
  sendPurchaseEvents        Boolean  @default(true) @map("send_purchase_events")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("meta_integration_settings")
}

model AdAttribution {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  contactId      String   @map("contact_id")
  conversationId String   @map("conversation_id")
  waMessageId    String?  @map("wa_message_id")
  ctwaClid       String   @map("ctwa_clid")
  sourceType     String?  @map("source_type")
  sourceId       String?  @map("source_id")
  sourceUrl      String?  @map("source_url")
  headline       String?
  body           String?
  mediaType      String?  @map("media_type")
  imageUrl       String?  @map("image_url")
  videoUrl       String?  @map("video_url")
  thumbnailUrl   String?  @map("thumbnail_url")
  welcomeMessage String?  @map("welcome_message")
  rawPayload     Json?    @map("raw_payload")
  receivedAt     DateTime @default(now()) @map("received_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact              Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)
  conversation         Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  metaConversionEvents MetaConversionEvent[]

  @@unique([organizationId, conversationId])
  @@index([organizationId, contactId, receivedAt])
  @@index([organizationId, ctwaClid])
  @@map("ad_attributions")
}

model MetaConversionEvent {
  id              String               @id @default(cuid())
  organizationId  String               @map("organization_id")
  saleId          String?              @map("sale_id")
  attributionId   String?              @map("attribution_id")
  contactId       String?              @map("contact_id")
  conversationId  String?              @map("conversation_id")
  eventName       String               @map("event_name")
  eventId         String               @unique @map("event_id")
  status          MetaConversionStatus @default(PENDING)
  requestPayload  Json?                @map("request_payload")
  responsePayload Json?                @map("response_payload")
  errorMessage    String?              @map("error_message")
  sentAt          DateTime?            @map("sent_at")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale?          @relation(fields: [saleId], references: [id], onDelete: SetNull)
  attribution  AdAttribution? @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  conversation Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, saleId])
  @@index([organizationId, attributionId])
  @@map("meta_conversion_events")
}
