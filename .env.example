# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Auth
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://wa_crm:wa_crm@localhost:5432/wa_crm?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# WhatsApp Cloud API - Meta
DEFAULT_ORGANIZATION_ID=demo-org
META_GRAPH_API_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=replace-with-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-waba-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-private-verify-token

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
