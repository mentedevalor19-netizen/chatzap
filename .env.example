# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# Auth
JWT_SECRET=change-me-with-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# Database
DATABASE_URL=postgresql://wa_crm:wa_crm@localhost:5432/wa_crm?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# WhatsApp Cloud API - Meta
DEFAULT_ORGANIZATION_ID=demo-org
META_GRAPH_API_VERSION=v20.0
WHATSAPP_ACCESS_TOKEN=replace-with-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-waba-id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-private-verify-token

# Atendimento automatico inicial
FUNNEL_ENABLED=true
FUNNEL_ASSIGN_TO_HUMAN=true
FUNNEL_MESSAGE_1=Olá! Recebemos sua mensagem. Para agilizar, me diga qual opção combina melhor com o que você precisa:\n\n1 - Comercial\n2 - Suporte\n3 - Financeiro
FUNNEL_MESSAGE_2=Perfeito. Já estou chamando um especialista para continuar seu atendimento por aqui.
FUNNEL_HANDOFF_MESSAGE=Atendimento humano iniciado.

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
