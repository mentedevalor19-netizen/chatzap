{
  "name": "whatsapp-cloud-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "prisma:generate": "pnpm --filter @wa-crm/api prisma generate",
    "db:migrate": "pnpm --filter @wa-crm/api prisma migrate dev",
    "db:seed": "pnpm --filter @wa-crm/api prisma db seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0"
  }
}
